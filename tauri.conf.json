{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Shared Runtime Manager",
  "version": "0.6.0",
  "identifier": "com.julianodev.shared-runtime-manager",
  "build": { "frontendDist": "ui" },
  "app": {
    "withGlobalTauri": true,
    "windows": [{ "title": "Shared Runtime Manager", "width": 1180, "height": 780, "minWidth": 920, "minHeight": 640, "resizable": true }],
    "security": { "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self'; img-src 'self' data:" }
  },
  "bundle": { "active": true, "targets": ["nsis", "msi"] }
}
